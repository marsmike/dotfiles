# Claude Code routed through local MLX backend via Rapid-MLX (native Anthropic endpoint)
# Daemon: ~/Library/LaunchAgents/com.mike.rapidmlx.plist (port 8000)
# Backend: Rapid-MLX serving mlx-community/Ornith-1.0-35B-{4,5,8}bit with --no-thinking
# Usage:
#   cclm            run against whatever quant the daemon currently has loaded
#   cclm 5bit       hot-swap daemon to Ornith-1.0-35B-5bit if needed, then run
#   cclm 4bit       same for -4bit
#   cclm 8bit       same for -8bit
# The bare number form ("cclm 5") also works and is treated as "5bit".
function cclm() {
  local plist=~/Library/LaunchAgents/com.mike.rapidmlx.plist
  # Only treat $1 as a quant selector if it matches Nbit / N-digit form.
  # Anything else (a claude arg like "-c", "--help", or a raw prompt) is
  # passed straight through to claude so the bare passthrough interface
  # stays intact.
  if [[ "$1" =~ ^[0-9]+(bit)?$ ]]; then
    local requested="${1%bit}bit"
    local target_id="mlx-community/Ornith-1.0-35B-${requested}"
    local current_id
    current_id=$(grep -oE 'mlx-community/Ornith-1.0-35B-[0-9]+bit' "$plist")
    if [[ "$current_id" != "$target_id" ]]; then
      print -u2 -P "%F{109}cclm: swapping backend ${current_id} -> ${target_id} ...%f"
      sed -i '' "s|mlx-community/Ornith-1.0-35B-[0-9]*bit|$target_id|" "$plist"
      launchctl bootout gui/$(id -u) "$plist" 2>/dev/null
      launchctl bootstrap gui/$(id -u) "$plist" || {
        print -u2 -P "%F{160}cclm: launchctl bootstrap failed%f"; return 1;
      }
      local i
      for i in {1..30}; do
        curl -s --max-time 2 -H "Authorization: Bearer sk-rapidmlx-local" \
          http://127.0.0.1:8000/v1/models >/dev/null 2>&1 && break
        sleep 1
      done
      if [[ $i -eq 30 ]]; then
        print -u2 -P "%F{160}cclm: server did not become healthy within 30s — check ~/Library/Logs/rapidmlx/rapidmlx.err.log%f"
        return 1
      fi
      print -u2 -P "%F{109}cclm: ${target_id} ready%f"
    fi
    (source ~/.ornith.env \
      && export ANTHROPIC_MODEL="$target_id" \
                ANTHROPIC_SMALL_FAST_MODEL="$target_id" \
                CLAUDE_CODE_SUBAGENT_MODEL="$target_id" \
      && claude --permission-mode auto "${@:2}")
  else
    (source ~/.ornith.env && claude --permission-mode auto "$@")
  fi
}

