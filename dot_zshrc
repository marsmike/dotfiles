alias ccf='_cc "claude-fable-5-1[1m]"'        # Fable 5.1 — thinking always on, most capable

# Claude Code OAuth token created by `claude setup-token`, stored in Keychain.
if [[ -z "${CLAUDE_CODE_OAUTH_TOKEN:-}" ]]; then
