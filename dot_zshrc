  if [[ -n "$_claude_code_oauth_token" ]]; then
    export CLAUDE_CODE_OAUTH_TOKEN="$_claude_code_oauth_token"
  fi
  unset _claude_code_oauth_token
fi

# Claude Code routed through local LM Studio (Anthropic-compatible /v1/messages @ :1234)
# Model: qwen3.8-27b-splash (splash engine), JIT-loaded on first request.
# Env:   ~/.lmstudio.env (chezmoi: dot_lmstudio.env, no secret)
function cclm() {
  (source ~/.lmstudio.env && claude --dangerously-skip-permissions "$@")
}

# Claude Code routed through the F3A homelab box (Ornith-1.0-35B Q6_K-MTP, 35.9 t/s)
# Gateway: llama.cpp native Anthropic /v1/messages via llama-swap @ 192.168.1.154:8080
function cclmf3a() {
  (source ~/.ornith-f3a.env && claude --dangerously-skip-permissions "$@")
}

# Claude Code routed through Kimi / Moonshot (Anthropic-compatible endpoint)
# Docs:  https://platform.kimi.ai/docs/guide/claude-code-kimi
# Creds: ~/.kimi.env (chezmoi: private_dot_kimi.env.tmpl, key from KIMI_ANTHROPIC_AUTH_TOKEN)
# Models: kimi-k3 (default, thinking on) · kimi-k2.7-code · kimi-k2.7-code-highspeed · kimi-k2.6
# Override per run:  KIMI_MODEL=kimi-k2.7-code-highspeed cck
# Takes the same -wt worktree flag as cc/cco/cch/ccf.
function cck() {
  (source ~/.kimi.env && _cc "${KIMI_MODEL:-kimi-k3}" "$@")
}

