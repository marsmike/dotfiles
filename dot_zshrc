# Claude Code launchers: bypass permissions (yolo), explicit model version, own git worktree.
#
# Models are pinned to explicit versioned ids on purpose. The bare `opus` /
# `sonnet` aliases have repeatedly lagged a generation behind during staged
# rollouts, and a --model flag here overrides ANTHROPIC_DEFAULT_*_MODEL from
# ~/.env anyway. Bump by hand each release; last bumped 2026-09-25 (Opus 5.5).
#
# Runs in the current checkout by default; -wt opts into worktree isolation
# (see ~/.claude/nodes/parallel-agents.md):
#   cco                     -> current checkout, on whatever branch is out
#   cco -wt                 -> worktree <repo>-<YYYYmmdd-HHMM>
#   cco -wt fix-auth        -> worktree "fix-auth"
#   cco -hr                 -> same, launched through the headroom compression proxy
#   cco "fix the bug"       -> prompt still passes through untouched
# Outside a git repo -wt is ignored automatically.
function _cc() {
  local model="$1"; shift
  local name="" wt=0 headroom=0
  local -a args
  while (( $# )); do
    case "$1" in
      -hr) headroom=1; shift ;;
      -wt)
        wt=1; shift
        if [[ -n "$1" && "$1" != -* ]]; then name="$1"; shift; fi
        ;;
      *) args+=("$1"); shift ;;
    esac
  done

  local -a model_flag
  [[ -n "$model" ]] && model_flag=(--model "$model")

  # -hr routes through `headroom wrap claude` instead of bare `claude`. Only
  # pass headroom's --1m when the model id itself already carries [1m] —
  # forcing it onto a non-1m model (e.g. cch's haiku) would mint an invalid
  # model id. See ~/.headroom docs / issue #1158 on why --1m is needed at all:
  # a custom ANTHROPIC_BASE_URL otherwise silently drops the suffix and caps
  # the session at 200k.
  local -a launcher=(claude)
  if (( headroom )); then
    launcher=(headroom wrap claude)
    [[ "$model" == *'[1m]'* ]] && launcher+=(--1m)
  fi

  if (( ! wt )) || ! git rev-parse --show-toplevel >/dev/null 2>&1; then
    "${launcher[@]}" "${model_flag[@]}" --dangerously-skip-permissions "${args[@]}"
    return
  fi

  if [[ -z "$name" ]]; then
    name="$(basename "$(git rev-parse --show-toplevel)")-$(date +%Y%m%d-%H%M)"
  fi
  print -u2 -P "%F{109}worktree: ${name}%f"
  "${launcher[@]}" "${model_flag[@]}" --worktree "$name" --dangerously-skip-permissions "${args[@]}"
}

alias cc='_cc "claude-sonnet-5[1m]"'          # Sonnet 5, 1M context — everyday driver
alias cco='_cc "claude-opus-5-5[1m]"'         # Opus 5.5, 1M context — heavier reasoning
