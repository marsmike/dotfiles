# Claude Code launchers: auto mode, explicit model version, own git worktree.
#
# Models are pinned to explicit versioned ids on purpose. The bare `opus` /
# `sonnet` aliases have repeatedly lagged a generation behind during staged
# rollouts, and a --model flag here overrides ANTHROPIC_DEFAULT_*_MODEL from
# ~/.env anyway. Bump by hand each release; last bumped 2026-07-26 (Opus 5).
#
# Worktree isolation is the default (see ~/.claude/nodes/parallel-agents.md):
#   cco                     -> worktree <repo>-<YYYYmmdd-HHMM>
#   cco -w fix-auth         -> worktree "fix-auth"
#   cco --no-wt             -> current checkout, no worktree (read-only work)
#   cco "fix the bug"       -> prompt still passes through untouched
# Outside a git repo the worktree step is skipped automatically.
function _cc() {
  local model="$1"; shift
  local name="" skip=0
  local -a args
  while (( $# )); do
    case "$1" in
      --no-wt) skip=1; shift ;;
      -w|--worktree)
        shift
        if [[ -n "$1" && "$1" != -* ]]; then name="$1"; shift; fi
        ;;
      *) args+=("$1"); shift ;;
    esac
  done

  local -a model_flag
  [[ -n "$model" ]] && model_flag=(--model "$model")

  if (( skip )) || ! git rev-parse --show-toplevel >/dev/null 2>&1; then
    claude "${model_flag[@]}" --permission-mode auto "${args[@]}"
    return
  fi

  if [[ -z "$name" ]]; then
    name="$(basename "$(git rev-parse --show-toplevel)")-$(date +%Y%m%d-%H%M)"
  fi
  print -u2 -P "%F{109}worktree: ${name}%f"
  claude "${model_flag[@]}" --worktree "$name" --permission-mode auto "${args[@]}"
}

