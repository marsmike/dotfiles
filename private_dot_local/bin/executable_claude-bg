#!/usr/bin/env bash
# claude-bg — spawn a DETACHED tmux session running Claude Code.
#
# Usage: claude-bg [--remote] <name> [dir] [fable|opus|sonnet|default]
#   name      tmux session name; also the session's display name in Claude
#             (prompt box, /resume picker, terminal title)
#   dir       working directory (default: $HOME/work; must already exist)
#   model     fable | opus | sonnet | default  (default: default)
#             fable/opus/sonnet pin explicit 1M ids (bare aliases lag releases)
#   --remote  start with Remote Control enabled, named <name>
#             (accepted anywhere in the args; requires a prior `claude /login`)
#
# Permissions: --permission-mode auto, same as the cc* shell aliases.
#
# Idempotent: if a session <name> already exists, prints the attach hint
# and exits 0 without clobbering it.
set -euo pipefail

usage() {
  sed -n '2,16p' "$0" | sed 's/^# \{0,1\}//'
  exit "${1:-0}"
}

# --- arg parsing: pull out --remote (anywhere), keep positionals in order ---
remote=0
positionals=()
for arg in "$@"; do
  case "$arg" in
    -h|--help) usage 0 ;;
    --remote)  remote=1 ;;
    *)         positionals+=("$arg") ;;
  esac
done

[[ ${#positionals[@]} -lt 1 ]] && usage 0

name="${positionals[0]}"
dir="${positionals[1]:-$HOME/work}"
model="${positionals[2]:-default}"

tmux_bin="$(command -v tmux || true)"
[[ -z "$tmux_bin" ]] && { echo "error: tmux not found on PATH (brew install tmux)" >&2; exit 1; }

claude_bin="$(command -v claude || true)"
[[ -z "$claude_bin" ]] && claude_bin="/opt/homebrew/bin/claude"
[[ -x "$claude_bin" ]] || { echo "error: claude not found (looked on PATH and /opt/homebrew/bin/claude)" >&2; exit 1; }

[[ -d "$dir" ]] || { echo "error: directory does not exist: $dir" >&2; exit 1; }

case "$model" in
  fable)   model_flag=(--model 'claude-fable-5-1[1m]') ;;
  opus)    model_flag=(--model 'claude-opus-5[1m]') ;;
  sonnet)  model_flag=(--model 'claude-sonnet-5[1m]') ;;
  default) model_flag=() ;;
  *) echo "error: unknown model '$model' (use fable|opus|sonnet|default)" >&2; exit 1 ;;
esac

# Remote Control is a native flag now (claude --remote-control [name]); no
# need to drive /remote-control through the pane after boot.
remote_flag=()
(( remote )) && remote_flag=(--remote-control "$name")

# Assembled as one shell-quoted string because tmux new-session takes a
# shell command, not an argv.
# ${arr[@]+"${arr[@]}"}: empty arrays are "unbound" under set -u in bash 3.2.
cmd="$(printf '%q ' "$claude_bin" --name "$name" ${model_flag[@]+"${model_flag[@]}"} ${remote_flag[@]+"${remote_flag[@]}"} --permission-mode auto)"
cmd="${cmd% }"

attach_hints() {
  echo "Attach:        tmux attach -t $name"
  echo "Attach (GUI):  open -na Ghostty.app --args -e tmux attach -t $name"
}

# pane() — current visible pane text for $name (never aborts the script).
pane() {
  "$tmux_bin" capture-pane -t "$name" -p -S -60 2>/dev/null || true
}

# accept_trust() — the one interactive gate --remote-control cannot pass on
# its own: the first-run folder-trust prompt for a directory. Polls briefly and
# picks "Yes, I trust this folder" if it shows up; otherwise a detached --remote
# session would sit on the dialog and never connect. The dialog's default is
# "No, exit", so it takes a Down before Enter.
accept_trust() {
  local deadline=$(( SECONDS + 15 ))
  while (( SECONDS < deadline )); do
    if pane | grep -qiE 'trust the files|Yes, I trust'; then
      "$tmux_bin" send-keys -t "$name" Down Enter
      return 0
    fi
    sleep 1
  done
  return 0
}

if "$tmux_bin" has-session -t "$name" 2>/dev/null; then
  echo "Session '$name' already running — not clobbering."
  attach_hints
  exit 0
fi

# remain-on-exit on: keep the pane (and its final output / error) visible if
# claude exits, so you can read why instead of the window vanishing.
"$tmux_bin" new-session -d -s "$name" -c "$dir" "$cmd"
"$tmux_bin" set-option -t "$name" remain-on-exit on

echo "Spawned tmux session '$name'"
echo "  dir:    $dir"
echo "  model:  $model"
echo "  cmd:    $cmd"

if (( remote )); then
  accept_trust
  sleep 4
  echo "  --- pane (Remote Control state) ---"
  pane | grep -v '^\s*$' | tail -8 | sed 's/^/  /'
fi

attach_hints
