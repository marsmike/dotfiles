# Claude Code -> local LM Studio (Anthropic-compatible /v1/messages on :1234)
# Model: qwen3.8-27b-splash (splash engine, 262k ctx, tool use); JIT-loaded on first request.
# Used by `cclm` in ~/.zshrc. No secret here — LM Studio ignores the token.
export ANTHROPIC_BASE_URL="http://127.0.0.1:1234"
export ANTHROPIC_AUTH_TOKEN="lm-studio"
export ANTHROPIC_MODEL="qwen3.8-27b-splash"
export ANTHROPIC_DEFAULT_OPUS_MODEL="qwen3.8-27b-splash"
export ANTHROPIC_DEFAULT_SONNET_MODEL="qwen3.8-27b-splash"
export ANTHROPIC_DEFAULT_HAIKU_MODEL="qwen3.8-27b-splash"
export ANTHROPIC_DEFAULT_FABLE_MODEL="qwen3.8-27b-splash"
export CLAUDE_CODE_SUBAGENT_MODEL="qwen3.8-27b-splash"
export CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC=1
# Local prefill of a long agentic context can take minutes; default is 10 min.
export API_TIMEOUT_MS=1800000
# Loaded at the native 262144 window; compact against it, not the 200k default.
export CLAUDE_CODE_AUTO_COMPACT_WINDOW="262144"

# Don't send the Anthropic OAuth token / API key to the local endpoint.
unset CLAUDE_CODE_OAUTH_TOKEN ANTHROPIC_API_KEY
