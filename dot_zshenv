# ~/.zshenv — sourced for ALL zsh invocations (interactive, non-interactive, login, subshells).
# Keep minimal: PATH + essential env vars that non-interactive shells (ssh commands,
# systemd user services, cron, subprocess spawns) need in order to find our tools.
# Interactive niceties (prompt, aliases, completions) stay in .zshrc.

# --- User-local binaries (uv, claude, yt-dlp, aider, llm, ttok, lazygit, chezmoi, etc.) ---
case ":${PATH}:" in
  *":$HOME/.local/bin:"*) ;;
  *) export PATH="$HOME/.local/bin:$PATH" ;;
esac

# --- Bun ---
export BUN_INSTALL="$HOME/.bun"
if [ -d "$BUN_INSTALL/bin" ]; then
  case ":${PATH}:" in
    *":$BUN_INSTALL/bin:"*) ;;
    *) export PATH="$BUN_INSTALL/bin:$PATH" ;;
  esac
fi

# --- nvm node/npm (current LTS) ---
# Sourcing nvm.sh from .zshenv is too slow for every subshell. Instead, add the
# highest-versioned installed node's bin directory directly. Interactive shells
# still get full nvm via .zshrc if they need to switch versions.
export NVM_DIR="$HOME/.nvm"
if [ -d "$NVM_DIR/versions/node" ]; then
  _nvm_latest="$(ls -1 "$NVM_DIR/versions/node" 2>/dev/null | sort -V | tail -1)"
  if [ -n "$_nvm_latest" ]; then
    case ":${PATH}:" in
      *":$NVM_DIR/versions/node/$_nvm_latest/bin:"*) ;;
      *) export PATH="$NVM_DIR/versions/node/$_nvm_latest/bin:$PATH" ;;
    esac
  fi
  unset _nvm_latest
fi
