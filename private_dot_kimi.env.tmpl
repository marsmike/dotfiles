# Claude Code -> Kimi / Moonshot (Anthropic-compatible endpoint)
# Docs: https://platform.kimi.ai/docs/guide/claude-code-kimi
# Key:  ~/.env, as KIMI_ANTHROPIC_AUTH_TOKEN (all secrets live in ~/.env).
#       chezmoi reads it from the environment at apply time, so the key never
#       lands in this git-tracked source. After adding or rotating it:
#         source ~/.env && chezmoi apply ~/.kimi.env
#       New keys: https://platform.kimi.ai/console/api-keys
#
# Models: kimi-k3 (default, thinking on by default)
#         kimi-k2.7-code            (needs thinking enabled explicitly)
#         kimi-k2.7-code-highspeed  (5-6x faster output)
#         kimi-k2.6                 (thinking optional)
# Per-run override:  KIMI_MODEL=kimi-k2.7-code-highspeed cck
#
# Every model var must be set — the guide warns that omitting one fails
# silently in the corresponding scenario rather than erroring.

export ANTHROPIC_BASE_URL="https://api.moonshot.ai/anthropic"
export ANTHROPIC_AUTH_TOKEN={{ env "KIMI_ANTHROPIC_AUTH_TOKEN" | quote }}

export ANTHROPIC_MODEL="kimi-k3"
export ANTHROPIC_DEFAULT_OPUS_MODEL="kimi-k3"
export ANTHROPIC_DEFAULT_SONNET_MODEL="kimi-k3"
export ANTHROPIC_DEFAULT_HAIKU_MODEL="kimi-k3"
export ANTHROPIC_DEFAULT_FABLE_MODEL="kimi-k3"
export CLAUDE_CODE_SUBAGENT_MODEL="kimi-k3"

# Kimi-specific tuning from the setup guide
export ENABLE_TOOL_SEARCH="false"
export CLAUDE_CODE_AUTO_COMPACT_WINDOW="1048576"
export CLAUDE_CODE_EFFORT_LEVEL="max"

# Don't leak the Anthropic keychain OAuth token / API key to a third-party
# endpoint — cck sources this in a subshell, so these unsets are scoped to it.
unset CLAUDE_CODE_OAUTH_TOKEN ANTHROPIC_API_KEY
