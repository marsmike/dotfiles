#!/bin/bash
# Chezmoi modify script: only manage extraKnownMarketplaces in settings.json
# All other settings (plugins, statusLine, etc.) are per-machine and left untouched.

MARKETPLACES='{
  "agentic-toolkit-private": {
    "source": {
      "source": "git",
      "url": "https://github.com/marsmike/agentic-toolkit-private.git"
    },
    "autoUpdate": true
  },
  "agentic-toolkit": {
    "source": {
      "source": "git",
      "url": "https://github.com/marsmike/agentic-toolkit.git"
    },
    "autoUpdate": true
  }
}'

# Read existing file from stdin (chezmoi pipes current contents)
EXISTING="$(cat)"

if [ -z "$EXISTING" ] || [ "$EXISTING" = "{}" ]; then
  echo "{}" | jq --argjson mp "$MARKETPLACES" '.extraKnownMarketplaces = $mp'
else
  echo "$EXISTING" | jq --argjson mp "$MARKETPLACES" '.extraKnownMarketplaces = $mp'
fi
