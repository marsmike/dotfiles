#!/bin/bash
# Chezmoi modify script: manage the statusLine block and the default model in
# ~/.claude/settings.json. Everything else (enabledPlugins, hooks, tui, …) is
# per-machine and passed through untouched.
#
# model: pinned to an explicit versioned id, same reasoning as the cc aliases in
# ~/.zshrc (bare aliases lag releases). Bump here and there together.
#
# extraKnownMarketplaces (typesafe-ai, agentic-toolkit) is per-machine and passed
# through — the typesafe and agentic-toolkit plugins depend on it.
#
# permissions.defaultMode = bypassPermissions (operator choice 2026-09-25): agents
# run unattended under OpenRig (~/Developer/openrig); matches the cc* aliases'
# --dangerously-skip-permissions. skipDangerousModePermissionPrompt drops the
# one-time confirmation dialog for that mode.
#
# Per-machine override: ~/.config/claude-permission-mode holds one word (auto,
# default, acceptEdits, plan or bypassPermissions) and is not managed by chezmoi.
# With no file, or an empty one, the mode stays bypassPermissions. An unknown word
# falls back to default, because a typo must never grant more than was asked for.
# The dialog skip only applies to bypassPermissions. The cc* aliases read the same file.
#
# Status line: ccstatusline (https://github.com/sirmalloc/ccstatusline).
# Layout lives in ~/.config/ccstatusline/settings.json, also managed by chezmoi.
# An absolute command path is required: the status line runs in a spawned shell
# that does not reliably inherit PATH.

CCSTATUSLINE="$(command -v ccstatusline 2>/dev/null)"
[ -n "$CCSTATUSLINE" ] || CCSTATUSLINE="$HOME/.bun/bin/ccstatusline"

# refreshInterval keeps the 5h reset countdown ticking while the session is
# idle waiting on background subagents; event-driven updates alone go quiet.
STATUSLINE="$(jq -n --arg cmd "$CCSTATUSLINE" '{
  type: "command",
  command: $cmd,
  refreshInterval: 15
}')"

# Read existing file from stdin (chezmoi pipes current contents)
EXISTING="$(cat)"
[ -n "$EXISTING" ] || EXISTING='{}'

# vault-guard: PreToolUse hook making deletes inside the Obsidian vault
# recoverable (rm -> trash). The vault stays writable — it is the memory
# substrate — so only the irreversible op is gated. Added idempotently to the
# Bash matcher, alongside whatever else that matcher already runs (rtk).
GUARD="$(jq -n --arg cmd "python3 '$HOME/.claude/hooks/vault-guard.sh'" '{
  type: "command",
  command: $cmd,
  timeout: 10
}')"

# scalable-guard: PreToolUse hook enforcing the broker rules on the Scalable
# MCP in code (broker account only, never the Tagesgeldkonto; submit_* only
# after a preview and Mike's explicit yes). The claude.ai Scalable connector
# loads on every machine signed in to the account, trade tools included, and
# defaultMode is bypassPermissions — so the guard must travel with it.
SCALABLE_GUARD="$(jq -n --arg cmd "python3 '$HOME/.claude/hooks/scalable-guard.py'" '{
  matcher: "mcp__scalable__.*|mcp__claude_ai_Scalable__.*",
  hooks: [{type: "command", command: $cmd, timeout: 10}]
}')"

MODEL='claude-opus-5-5[1m]'

# Model roles (Mike, 2026-11-01): main session Opus 5.5 (above), advisor Fable 5.2, subagents
# Sonnet 5.5 by default (CLAUDE_CODE_SUBAGENT_MODEL covers the built-in general-purpose/Plan/
# Explore agents, which would otherwise inherit Opus). Agents that pin `model:` in their
# frontmatter keep it: worker = Sonnet 5.5, scout/researcher = Haiku 5.5
# (~/work/claude-subagents/agents). Bump versioned ids here and there together.
ADVISOR='claude-fable-5-2'
SUBAGENT_MODEL='claude-sonnet-5-5'
# The bare aliases lag releases (checked 2026-11-01: `sonnet` -> claude-sonnet-4-6,
# `haiku` -> claude-haiku-4-5), so pin what they resolve to as well.
SONNET='claude-sonnet-5-5'
HAIKU='claude-haiku-5-5'

PERMISSION_MODE="$(tr -d '[:space:]' 2>/dev/null < "$HOME/.config/claude-permission-mode" || true)"
case "$PERMISSION_MODE" in
  '') PERMISSION_MODE='bypassPermissions' ;;
  auto|default|acceptEdits|plan|bypassPermissions) ;;
  *)
    echo "claude-permission-mode: unknown mode '$PERMISSION_MODE', using default" >&2
    PERMISSION_MODE='default'
    ;;
esac

echo "$EXISTING" | jq --argjson sl "$STATUSLINE" --argjson guard "$GUARD" --argjson sguard "$SCALABLE_GUARD" --arg model "$MODEL" --arg advisor "$ADVISOR" --arg sub "$SUBAGENT_MODEL" --arg sonnet "$SONNET" --arg haiku "$HAIKU" --arg mode "$PERMISSION_MODE" '
    .statusLine = $sl
  | .model = $model
  | .advisorModel = $advisor
  | .env.CLAUDE_CODE_SUBAGENT_MODEL = $sub
  | .env.ANTHROPIC_DEFAULT_SONNET_MODEL = $sonnet
  | .env.ANTHROPIC_DEFAULT_HAIKU_MODEL = $haiku
  | .permissions.defaultMode = $mode
  | if $mode == "bypassPermissions"
    then .skipDangerousModePermissionPrompt = true
    else del(.skipDangerousModePermissionPrompt) end
  | .hooks.PreToolUse = (
      (.hooks.PreToolUse // [])
      | if any(.[]; .matcher == "Bash") then
          map(
            if .matcher == "Bash" then
              .hooks = (
                (.hooks // [])
                | if any(.[]; (.command // "") | test("vault-guard"))
                  then . else . + [$guard] end
              )
            else . end
          )
        else . + [{matcher: "Bash", hooks: [$guard]}] end
      | if any(.[]; any(.hooks[]?; (.command // "") | test("scalable-guard")))
        then . else . + [$sguard] end
    )
'
